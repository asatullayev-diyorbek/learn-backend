# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# Frontend origins allowed to call the API with credentials (comma separated).
# NOTE: in production the frontend and backend must share a domain (or be
# subdomains of one) for the session cookie to work with SameSite=Lax. If the
# frontend is truly on a different domain/origin, set SESSION_COOKIE_SAMESITE=None
# and SESSION_COOKIE_SECURE=True instead, and serve everything over HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
